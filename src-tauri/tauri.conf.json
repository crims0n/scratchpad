{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scratchpad Development",
  "version": "1.1.0",
  "identifier": "io.github.crims0n.scratchpad.dev",
  "mainBinaryName": "scratchpad-dev",
  "build": {
    "beforeBuildCommand": "npm run vendor",
    "beforeDevCommand": "npm run vendor",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Scratchpad Development",
        "width": 960,
        "height": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../LICENSE": "LICENSE",
      "../APP_STORE_EXCEPTION.md": "APP_STORE_EXCEPTION.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
