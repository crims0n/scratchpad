{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scratchpad",
  "version": "0.8.2",
  "identifier": "io.github.crims0n.scratchpad.beta",
  "build": {
    "beforeBuildCommand": "npm run vendor",
    "beforeDevCommand": "npm run vendor",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Scratchpad",
        "width": 960,
        "height": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "upgradeCode": "425f5eeb-5cef-5929-8fcc-d21bcbaf7de9"
      }
    },
    "linux": {
      "deb": {
        "conflicts": ["scratchpad-beta"],
        "replaces": ["scratchpad-beta"]
      }
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
