{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "allow-get-update-info",
    "allow-check-for-updates",
    "allow-open-update-release",
    "allow-load-workspace-preference",
    "allow-set-last-workspace",
    "allow-save-file-native",
    "allow-save-html-file-native",
    "allow-open-note-print",
    "allow-save-recovery-file-native",
    "allow-save-collection-backup",
    "allow-read-collection-backup",
    "allow-preserve-collection-backup",
    "allow-begin-local-restore",
    "allow-read-local-restore",
    "allow-complete-local-restore",
    "allow-workspace-collection-initialized",
    "allow-archive-local-recovery",
    "allow-has-local-recovery-copies",
    "allow-read-local-recovery-copies",
    "allow-import-file-native",
    "allow-select-db-file",
    "allow-load-db-notes",
    "allow-load-db-folders",
    "allow-load-db-trash",
    "allow-save-note-db",
    "allow-save-notes-db",
    "allow-save-folders-db",
    "allow-save-workspace-db",
    "allow-show-alert-dialog",
    "allow-update-mcp-snapshot",
    "allow-update-mcp-note",
    "allow-get-mcp-connection-info",
    "allow-start-mcp-server",
    "allow-set-mcp-permissions",
    "allow-complete-mcp-write",
    "allow-stop-mcp-server"
  ]
}
